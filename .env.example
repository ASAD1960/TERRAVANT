# Copy this file to .env for local development.
# Never commit a real .env file or production secrets.
#
# Generate a strong secret with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Replace the placeholder below with the generated value before production use.

ENV=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
DATABASE_URL=postgresql+psycopg2://terravant:terravant@db:5432/terravant
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
POSTGRES_USER=terravant
POSTGRES_PASSWORD=terravant
POSTGRES_DB=terravant
# Password reset email (optional in development; required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_S=10
FRONTEND_URL=http://localhost:5173
